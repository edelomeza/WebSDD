@page
@model WebSDD.Pages.LoginModel
@{
    ViewData["Title"] = "Inicio de sesión";
}

<div class="d-flex align-items-center justify-content-center">
    <div class="card shadow-sm login-card">
        <div class="card-body">
            <h1 class="fw-bold text-center mb-4">Inicio de sesión</h1>
            <form method="post" asp-route-returnUrl="@Model.ReturnUrl" data-loading="spinner" novalidate>
                <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
                <div class="mb-3">
                    <label asp-for="Input.Usuario" class="form-label">Usuario</label>
                    <div class="input-group">
                        <span class="input-group-text"><i class="bi bi-person-circle" aria-hidden="true"></i></span>
                        <input asp-for="Input.Usuario" class="form-control" autocomplete="username" />
                    </div>
                    <span asp-validation-for="Input.Usuario" class="text-danger"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="Input.Password" class="form-label">Contraseña</label>
                    <div class="input-group">
                        <span class="input-group-text"><i class="bi bi-lock" aria-hidden="true"></i></span>
                        <input asp-for="Input.Password" class="form-control" autocomplete="current-password" />
                        <button type="button" class="btn btn-outline-secondary" data-password-toggle="true" aria-label="Mostrar u ocultar contraseña">
                            <i class="bi bi-eye" aria-hidden="true"></i>
                        </button>
                    </div>
                    <span asp-validation-for="Input.Password" class="text-danger"></span>
                </div>
                <div class="form-check mb-3">
                    <input asp-for="Input.Recordarme" class="form-check-input" />
                    <label asp-for="Input.Recordarme" class="form-check-label">Recordarme</label>
                </div>
                <button type="submit" class="btn btn-login w-100">
                    <span class="btn-text">Ingresar</span>
                    <span class="spinner-border spinner-border-sm d-none" role="status" aria-hidden="true"></span>
                </button>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
