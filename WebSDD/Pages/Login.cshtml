@page
@model WebSDD.Pages.LoginModel
@{
    ViewData["Title"] = "Inicio de sesión";
}

<div class="row justify-content-center login-wrap g-0">
    <div class="col-12 login-col">
        <div class="card login-card mx-auto">
            <div class="card-body p-4 p-md-5">
                <h1 class="fw-bold mb-2 login-title">Inicio de sesión</h1>
                <p class="text-muted small mb-4 text-start">Usa tus credenciales corporativas para entrar a la plataforma.</p>
                <form method="post" asp-route-returnUrl="@Model.ReturnUrl" data-loading="spinner" novalidate>
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
                    <div class="mb-3">
                        <label asp-for="Input.Usuario" class="form-label fw-semibold">Usuario</label>
                        <div class="input-group input-group-lg">
                            <span class="input-group-text"><i class="bi bi-person-circle" aria-hidden="true"></i></span>
                            <input asp-for="Input.Usuario" class="form-control" autocomplete="username" autofocus placeholder="Nombre de usuario" />
                        </div>
                        <span asp-validation-for="Input.Usuario" class="text-danger"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="Input.Password" class="form-label fw-semibold">Contraseña</label>
                        <div class="input-group input-group-lg">
                            <span class="input-group-text"><i class="bi bi-lock" aria-hidden="true"></i></span>
                            <input asp-for="Input.Password" class="form-control" autocomplete="current-password" enterkeyhint="go" placeholder="Contraseña" data-caps-warn="#capsLockWarn" />
                            <button type="button" class="btn password-eye" data-password-toggle="true" aria-label="Mostrar u ocultar contraseña">
                                <i class="bi bi-eye" aria-hidden="true"></i>
                            </button>
                        </div>
                        <div id="capsLockWarn" class="caps-alert d-none" role="status"><i class="bi bi-lock-fill" aria-hidden="true"></i> Bloq Mayús activado</div>
                        <span asp-validation-for="Input.Password" class="text-danger"></span>
                    </div>
                    <div class="form-check mb-1">
                        <input asp-for="Input.Recordarme" class="form-check-input" />
                        <label asp-for="Input.Recordarme" class="form-check-label">Recordarme</label>
                    </div>
                    <p class="login-hint text-body-secondary mt-0 mb-3">Mantiene tu sesión 24 horas en este equipo. No lo marques en equipos compartidos.</p>
                    <button type="submit" class="btn btn-login btn-lg w-100 fw-bold text-uppercase">
                        <i class="bi bi-box-arrow-in-right" aria-hidden="true"></i>
                        <span class="btn-text">Ingresar</span>
                        <span class="spinner-border spinner-border-sm d-none" role="status" aria-hidden="true"></span>
                    </button>
                </form>
            </div>
        </div>
        <div class="login-footer text-center small text-muted mt-3">
            <span><i class="bi bi-shield-check" aria-hidden="true"></i> Datos protegidos</span>
            <span aria-hidden="true"> · </span>
            <span><i class="bi bi-person-lock" aria-hidden="true"></i> Privacidad</span>
            <span aria-hidden="true"> · </span>
            <span><i class="bi bi-headset" aria-hidden="true"></i> Soporte</span>
            <div>&copy; 2026 - WebSDD</div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
